#!/usr/bin/env python3
"""Script wrapper pour social-graph CLI."""
import sys
from pathlib import Path


def main() -> None:
    """Point d'entrée du wrapper."""
    # Ajouter src/ au path Python
    project_root = Path(__file__).parent
    sys.path.insert(0, str(project_root / "src"))

    # Importer et exécuter
    from social_graph.cli import main as cli_main  # noqa: E402  # type: ignore
    cli_main()


if __name__ == '__main__':
    main()
